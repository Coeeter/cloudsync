NODE_ENV=development
DATABASE_URL=postgres://cloudsync:cloudsync@localhost:54329/cloudsync
OWNER_EMAIL=you@example.com
SESSION_SECRET=replace-with-at-least-32-random-bytes
PUBLIC_URL=http://localhost:3000
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=cloudsync
AWS_SECRET_ACCESS_KEY=cloudsync-local-secret
S3_BUCKET=cloudsync
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
CLOUDFRONT_URL=http://localhost:9000/cloudsync
# Set to .example.com in production. Leave unset locally so previews use signed URLs.
CLOUDFRONT_COOKIE_DOMAIN=
RESEND_API_KEY=
RESEND_FROM=CloudSync <noreply@example.com>
