{
  "name": "@cloudsync/ui",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-progress": "1.1.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.3.0",
    "lucide-react": "0.544.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.0",
    "tailwind-merge": "3.3.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "tailwindcss": "4.3.3",
    "@types/bun": "1.3.10",
    "@types/react": "19.1.16",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
