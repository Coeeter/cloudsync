{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudsync-local",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "d1_databases": [{"binding":"DB","database_name":"cloudsync","database_id":"local-cloudsync","migrations_dir":"../../packages/db/migrations"}],
  "vars": {"NODE_ENV":"development"},
  "triggers": {"crons": ["*/5 * * * *"]},
  "observability": {"enabled": true},
  "env": {
    "prod": {
      "name": "cloudsync",
      "account_id": "00000000000000000000000000000000",
      // Maintenance purges expired trash and deletes S3 objects; enable only after cutover.
      "triggers": {"crons": []},
      "vars": {"NODE_ENV":"production"},
      "d1_databases": [{"binding":"DB","database_name":"cloudsync-prod","database_id":"c6936271-9153-4d71-b636-c37f3a135ee6","migrations_dir":"../../packages/db/migrations"}]
    }
  }
}
