{
  "name": "@cloudsync/cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3310 --strictPort",
    "build": "vite build && bun run build:lambda",
    "build:lambda": "bun build src/lambda/zip.ts --target=node --format=esm --outdir=dist-lambda --entry-naming=zip.mjs",
    "check": "tsr generate && tsc -p tsconfig.json --noEmit",
    "test": "bun test src",
    "db:local": "wrangler d1 migrations apply cloudsync --local",
    "preview": "wrangler dev --port 3310",
    "local:zip": "sh -c '. scripts/local/env.sh && bun scripts/local/zip-server.ts'",
    "test:e2e": "sh -c '. scripts/local/env.sh && bun test src/server/catalog.e2e.test.ts'"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "3.1141.0",
    "@aws-sdk/client-lambda": "3.1146.0",
    "@aws-sdk/client-s3": "3.1141.0",
    "@aws-sdk/client-ssm": "3.1146.0",
    "@aws-sdk/cloudfront-signer": "3.1138.0",
    "@aws-sdk/lib-storage": "3.1141.0",
    "@aws-sdk/s3-request-presigner": "3.1141.0",
    "@cloudsync/core": "workspace:*",
    "@cloudsync/db": "workspace:*",
    "@cloudsync/domain": "workspace:*",
    "@cloudsync/ui": "workspace:*",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-start": "1.168.58",
    "archiver": "8.0.0",
    "aws4fetch": "1.0.20",
    "effect": "4.0.0-rc.117",
    "lucide-react": "0.544.0",
    "pdfjs-dist": "6.4.299",
    "postgres": "3.4.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "resend": "6.30.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@cloudflare/workers-types": "5.20261005.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.38",
    "@types/archiver": "8.0.0",
    "@types/aws-lambda": "8.10.164",
    "@types/bun": "1.3.10",
    "@types/node": "26.0.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.0.1",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.0.0",
    "wrangler": "4.147.0"
  }
}
