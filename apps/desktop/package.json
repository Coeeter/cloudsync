{
  "name": "@cloudsync/desktop",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/renderer/src/components/*.tsx",
    "#hooks/*": "./src/renderer/src/hooks/*.ts",
    "#lib/*": "./src/renderer/src/lib/*.ts"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --mac dir --arm64",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test src"
  },
  "devDependencies": {
    "@cloudsync/core": "workspace:*",
    "@cloudsync/domain": "workspace:*",
    "@cloudsync/ui": "workspace:*",
    "@effect/platform-node": "4.0.0-rc.117",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.3.10",
    "@types/node": "26.0.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.0.1",
    "chokidar": "5.0.0",
    "effect": "4.0.0-rc.117",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "lucide-react": "0.544.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.0.0"
  },
  "build": {
    "appId": "dev.nasnoor.cloudsync",
    "productName": "CloudSync",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "asar": true
  }
}
