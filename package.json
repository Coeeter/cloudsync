{
  "name": "cloudsync",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "dev": "turbo run dev --parallel",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "prepare": "effect-tsgo patch",
    "test": "turbo run test",
    "db:migrate": "bun --filter @cloudsync/cloud db:local"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@effect/language-service": "0.87.2",
    "@effect/tsgo": "0.46.0",
    "turbo": "2.5.8",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [
    "electron"
  ]
}
